{
  "schema": 1,
  "comment": "The checks that own each tracked path, read by owner-check of @polyspec/kit: make owner-check runs the owners of the changed paths, never the full suite, and the pre-commit hook runs make owner-validate. ordered-json-test-scripts runs the verifier unit tests (TESTS selects test files) and verify-<language> verifies one implementation.",
  "owners": [
    {
      "paths": [
        "**/*.md",
        "config/documents.json"
      ],
      "targets": [
        "docs-check"
      ]
    },
    {
      "paths": [
        "docs/features.md",
        "docs/features.ko.md",
        "docs/plans/execution/checklist.md",
        "docs/plans/execution/checklist.ko.md"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "push-gate-commit",
        "docs-check",
        "evidence-check"
      ]
    },
    {
      "paths": [
        "tests/scripts/*.test.mts"
      ],
      "targets": [
        "ordered-json-test-scripts"
      ],
      "variable": "TESTS"
    },
    {
      "paths": [
        "tests/scripts/checkout.mts"
      ],
      "targets": [
        "ordered-json-test-scripts"
      ]
    },
    {
      "paths": [
        "scripts/registry.mts",
        "scripts/reference.mts",
        "scripts/verify.mts",
        "config/parity.json",
        "examples/official.json",
        "contracts/fixtures/**"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "verify-js",
        "verify-rust",
        "verify-go",
        "verify-php",
        "verify-php-extension",
        "verify-python"
      ]
    },
    {
      "paths": [
        "scripts/records.mts",
        "scripts/json.mts",
        "scripts/present.mts",
        "scripts/schema/*.schema.json",
        "scripts/check-pie.mts",
        ".gitignore",
        "Makefile",
        "tsconfig.json"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "typecheck"
      ]
    },
    {
      "paths": [
        "benchmarks/run.mts"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "typecheck",
        "benchmark-check"
      ]
    },
    {
      "paths": [
        "benchmarks/*.{mjs,php,json}",
        "benchmarks/fixtures/*.json",
        "packages/rust/examples/benchmark.rs",
        "packages/go/internal/benchmark/*.go"
      ],
      "targets": [
        "benchmark-check"
      ]
    },
    {
      "paths": [
        "external-inputs.json",
        "package.json",
        "composer.json",
        "packages/js/package.json",
        "packages/php/composer.json",
        "packages/php-ext/composer.json",
        "packages/rust/Cargo.toml",
        "packages/go/go.mod",
        "packages/python/pyproject.toml"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "release-coverage",
        "release-config-check"
      ]
    },
    {
      "paths": [
        ".github/workflows/*.yml"
      ],
      "targets": [
        "ordered-json-test-scripts"
      ]
    },
    {
      "paths": [
        ".githooks/pre-commit",
        ".githooks/pre-push",
        "config/checklist.json",
        "config/owner-checks.json"
      ],
      "targets": [
        "hooks-check",
        "owner-validate",
        "push-gate-commit"
      ]
    },
    {
      "paths": [
        "scripts/kit/**",
        ".github/workflows/release.yml",
        ".claude/settings.json",
        "PRINCIPLES.md",
        "PRINCIPLES.ko.md",
        "ruff.toml",
        "clippy.toml",
        "phpcs.xml.dist",
        "phpstan.dist.neon",
        ".golangci.yml",
        ".oxlintrc.json",
        "knip.json",
        ".editorconfig",
        "config/api-extractor.kit.json",
        "config/pyproject.schema.json",
        "config/composer.schema.json",
        "config/cargo.schema.json",
        "config/php-lint/**",
        "package.json",
        "package-lock.json",
        "config/*.json"
      ],
      "targets": [
        "kit-check"
      ]
    },
    {
      "paths": [
        "config/parity.json",
        "examples/official.json",
        "packages/**",
        "docs/spec/*.md"
      ],
      "targets": [
        "parity-declarations-check",
        "parity-check"
      ]
    },
    {
      "paths": [
        "config/layout.kit.yml",
        "config/layout.yml"
      ],
      "targets": [
        "kit-check",
        "layout-check"
      ]
    },
    {
      "paths": [
        "packages/js/**"
      ],
      "targets": [
        "verify-js"
      ]
    },
    {
      "paths": [
        "packages/rust/**"
      ],
      "targets": [
        "verify-rust"
      ]
    },
    {
      "paths": [
        "packages/go/**"
      ],
      "targets": [
        "verify-go"
      ]
    },
    {
      "paths": [
        "packages/php/**"
      ],
      "targets": [
        "verify-php",
        "verify-php-extension"
      ]
    },
    {
      "paths": [
        "packages/php-ext/**"
      ],
      "targets": [
        "verify-php-extension"
      ]
    },
    {
      "paths": [
        "packages/python/**"
      ],
      "targets": [
        "verify-python"
      ]
    },
    {
      "paths": [
        "benchmarks/python-parse/*",
        "packages/python/src/polyspec/ordered_json/__init__.py"
      ],
      "targets": [
        "python-parse-budget"
      ]
    },
    {
      "paths": [
        "config/release.json",
        "tests/release-consumer/**",
        "CHANGELOG.md",
        "CHANGELOG.ko.md"
      ],
      "targets": [
        "release-coverage",
        "release-config-check"
      ]
    },
    {
      "paths": [
        "scripts/check-evidence.mts",
        "external-inputs.json"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "evidence-check"
      ]
    },
    {
      "paths": [
        "mise.toml",
        "mise.lock",
        ".mise/**",
        ".php-version",
        "rust-toolchain.toml",
        "config/toolchain.json",
        "packages/go/go.mod",
        "package.json"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "toolchain-check"
      ]
    },
    {
      "paths": [
        "packages/rust/Cargo.lock"
      ],
      "targets": [
        "cargo-downloads-check"
      ]
    },
    {
      "paths": [
        "config/dependency-policy.json",
        "config/dependency-review.json",
        "package-lock.json",
        "packages/rust/Cargo.lock",
        "packages/rust/Cargo.toml",
        "packages/python/pyproject.toml",
        "packages/go/go.mod",
        "package.json",
        "composer.json",
        "composer.lock",
        "packages/php/composer.json",
        "packages/php-ext/composer.json",
        "packages/js/package.json"
      ],
      "targets": [
        "dependency-policy-check",
        "dependency-policy-mutation-check"
      ]
    },
    {
      "paths": [
        "config/rebuild.json"
      ],
      "targets": [
        "rebuild-check"
      ]
    },
    {
      "paths": [
        "config/duplication.json"
      ],
      "targets": [
        "duplication-check"
      ]
    }
  ]
}
