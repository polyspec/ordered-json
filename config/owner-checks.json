{
  "schema": 1,
  "comment": "The checks that own each tracked path, read by owner-check of @polyspec/kit: make owner-check runs the owners of the changed paths, never the full suite, and the pre-commit hook runs make owner-validate. test-scripts runs the verifier unit tests (TESTS selects test files) and verify-<language> verifies one implementation.",
  "owners": [
    {
      "paths": [
        "**/*.md",
        "config/documents.json"
      ],
      "targets": [
        "documents-check"
      ]
    },
    {
      "paths": [
        "docs/features.md",
        "docs/features.ko.md",
        "docs/plans/execution-checklist.md",
        "docs/plans/execution-checklist.ko.md"
      ],
      "targets": [
        "test-scripts",
        "push-gate-commit",
        "documents-check",
        "evidence-check"
      ]
    },
    {
      "paths": [
        "scripts/tests/test_*.py"
      ],
      "targets": [
        "test-scripts"
      ],
      "variable": "TESTS"
    },
    {
      "paths": [
        "scripts/registry.py",
        "scripts/verify.py",
        "config/parity.json",
        "examples/official.json",
        "fixtures/**"
      ],
      "targets": [
        "test-scripts",
        "verify-js",
        "verify-rust",
        "verify-go",
        "verify-php",
        "verify-php-extension",
        "verify-python"
      ]
    },
    {
      "paths": [
        "scripts/verification_record.py",
        "scripts/check_pie.py",
        "scripts/compare_ojson.py",
        "scripts/comparison/*",
        "scripts/python_check.py",
        ".gitignore",
        "Makefile",
        "scripts/verification.py",
        "scripts/unit_tests.py",
        "scripts/external_inputs.py"
      ],
      "targets": [
        "test-scripts"
      ]
    },
    {
      "paths": [
        "scripts/lint.py"
      ],
      "targets": [
        "test-scripts",
        "clippy",
        "go-vet"
      ]
    },
    {
      "paths": [
        "benchmarks/run.py"
      ],
      "targets": [
        "test-scripts",
        "benchmark-check"
      ]
    },
    {
      "paths": [
        "benchmarks/*.{mjs,php,json}",
        "benchmarks/fixtures/*.json",
        "packages/ordered-json-rust/examples/benchmark.rs",
        "packages/ordered-json-go/internal/benchmark/*.go"
      ],
      "targets": [
        "benchmark-check"
      ]
    },
    {
      "paths": [
        "external-inputs.json",
        "package.json",
        "composer.json",
        "packages/ordered-json-npm/package.json",
        "packages/ordered-json-php/composer.json",
        "packages/ordered-json-php-ext/composer.json",
        "packages/ordered-json-rust/Cargo.toml",
        "packages/ordered-json-go/go.mod",
        "packages/ordered-json-python/pyproject.toml"
      ],
      "targets": [
        "test-scripts",
        "release-coverage",
        "release-config-check"
      ]
    },
    {
      "paths": [
        ".github/workflows/*.yml"
      ],
      "targets": [
        "test-scripts"
      ]
    },
    {
      "paths": [
        ".githooks/pre-commit",
        ".githooks/pre-push",
        "config/checklist.json",
        "config/owner-checks.json"
      ],
      "targets": [
        "hooks-check",
        "owner-validate",
        "push-gate-commit"
      ]
    },
    {
      "paths": [
        "scripts/kit/**",
        ".github/workflows/release.yml",
        "PRINCIPLES.md",
        "PRINCIPLES.ko.md",
        "ruff.toml",
        "phpcs.xml.dist",
        "phpstan.dist.neon",
        ".golangci.yml",
        ".oxlintrc.json",
        "knip.json",
        ".editorconfig",
        "config/api-extractor.kit.json",
        "config/pyproject.schema.json",
        "config/composer.schema.json",
        "config/cargo.schema.json",
        "config/php-lint/**",
        "package.json",
        "package-lock.json",
        "config/*.json"
      ],
      "targets": [
        "kit-check"
      ]
    },
    {
      "paths": [
        "config/parity.json",
        "examples/official.json",
        "packages/**",
        "docs/spec/*.md"
      ],
      "targets": [
        "parity-declarations-check",
        "parity-check"
      ]
    },
    {
      "paths": [
        "config/layout.kit.yml",
        "config/layout.yml"
      ],
      "targets": [
        "kit-check",
        "layout-check"
      ]
    },
    {
      "paths": [
        "packages/ordered-json-npm/**"
      ],
      "targets": [
        "verify-js"
      ]
    },
    {
      "paths": [
        "packages/ordered-json-rust/**"
      ],
      "targets": [
        "verify-rust"
      ]
    },
    {
      "paths": [
        "packages/ordered-json-go/**"
      ],
      "targets": [
        "verify-go"
      ]
    },
    {
      "paths": [
        "packages/ordered-json-php/**"
      ],
      "targets": [
        "verify-php",
        "verify-php-extension"
      ]
    },
    {
      "paths": [
        "packages/ordered-json-php-ext/**"
      ],
      "targets": [
        "verify-php-extension"
      ]
    },
    {
      "paths": [
        "packages/ordered-json-python/**"
      ],
      "targets": [
        "verify-python"
      ]
    },
    {
      "paths": [
        "benchmarks/python-parse/*",
        "packages/ordered-json-python/src/polyspec/ordered_json/__init__.py"
      ],
      "targets": [
        "python-parse-budget"
      ]
    },
    {
      "paths": [
        "config/release.json",
        "tests/release-consumer/**",
        "CHANGELOG.md",
        "CHANGELOG.ko.md"
      ],
      "targets": [
        "release-coverage",
        "release-config-check"
      ]
    },
    {
      "paths": [
        "scripts/check_evidence.py",
        "docs/reports/*.json",
        "external-inputs.json"
      ],
      "targets": [
        "test-scripts",
        "evidence-check"
      ]
    },
    {
      "paths": [
        "config/commits.json"
      ],
      "targets": [
        "commits-check"
      ]
    },
    {
      "paths": [
        ".node-version",
        "mise.toml",
        "mise.lock",
        ".mise/**",
        ".php-version",
        "rust-toolchain.toml",
        "config/toolchain.json",
        "packages/ordered-json-go/go.mod",
        "package.json"
      ],
      "targets": [
        "test-scripts",
        "toolchain-check"
      ]
    },
    {
      "paths": [
        "packages/ordered-json-rust/Cargo.lock"
      ],
      "targets": [
        "cargo-downloads-check"
      ]
    },
    {
      "paths": [
        "config/dependency-policy.json",
        "config/dependency-review.json",
        "package-lock.json",
        "packages/ordered-json-rust/Cargo.lock",
        "packages/ordered-json-rust/Cargo.toml",
        "packages/ordered-json-python/pyproject.toml",
        "packages/ordered-json-go/go.mod",
        "package.json",
        "composer.json",
        "packages/ordered-json-php/composer.json",
        "packages/ordered-json-php-ext/composer.json",
        "packages/ordered-json-npm/package.json"
      ],
      "targets": [
        "dependency-policy-check",
        "dependency-policy-mutation-check"
      ]
    }
  ]
}
