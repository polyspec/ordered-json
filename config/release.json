{
  "schema": 1,
  "repositoryUrl": "https://github.com/polyspec/ordered-json",
  "changelog": "CHANGELOG.md",
  "changelogTranslations": ["CHANGELOG.ko.md"],
  "checks": ["push-gate", "ci-passed"],
  "packages": [
    { "kind": "npm", "directory": "packages/js", "name": "@polyspec/ordered-json" },
    { "kind": "composer", "directory": "packages/php", "name": "polyspec/ordered-json" },
    { "kind": "composer", "directory": "packages/php-ext", "name": "polyspec/ordered-json-extension" },
    { "kind": "wheel", "directory": "packages/python", "name": "polyspec-ordered-json" }
  ],
  "manifests": {
    "package.json": "version",
    "packages/js/package.json": "archive",
    "composer.json": "version",
    "packages/php/composer.json": "archive",
    "packages/php-ext/composer.json": "archive",
    "packages/rust/Cargo.toml": "git-tag",
    "packages/python/pyproject.toml": "archive"
  },
  "notReleased": {
    "tests/release-consumer/npm/package.json": "the npm consumer project of the release archives",
    "tests/release-consumer/composer/composer.json": "the Composer consumer project of the release archives",
    ".mise/locks/pypi-vulture/2.16/pyproject.toml": "the uv project of the lock of vulture, a tool of mise.toml, which make toolchain-lock writes",
    "config/php-lint/composer.json": "the Composer project of the PHP lint tools of kit (phpcs, phpstan), which make install-tools installs into var/tools"
  },
  "buildBackend": {
    "requirement": "setuptools==84.0.0",
    "sha256": "51a52592b3b99e102b609654876bd65f19f999935166d1352678931132b0c670"
  },
  "goModules": {
    "packages/go": "github.com/polyspec/ordered-json/packages/go"
  },
  "consumers": {
    "npm": {
      "directory": "tests/release-consumer/npm",
      "smoke": {
        "@polyspec/ordered-json": [
          "node",
          "--input-type=module",
          "-e",
          "import { parse, stringify } from '@polyspec/ordered-json'; if (stringify(parse('{\"b\":1,\"a\":2}')) !== '{\"b\":1,\"a\":2}') throw new Error('the member order is not kept');"
        ]
      }
    },
    "composer": {
      "directory": "tests/release-consumer/composer",
      "smoke": {
        "polyspec/ordered-json": [
          "php",
          "-r",
          "require 'vendor/autoload.php'; if (Polyspec\\OrderedJson\\stringify(Polyspec\\OrderedJson\\Value::parse('{\"b\":1,\"a\":2}')) !== '{\"b\":1,\"a\":2}') { exit(1); }"
        ]
      }
    },
    "wheel": {
      "smoke": {
        "polyspec-ordered-json": ["python", "-c", "import importlib.resources, polyspec.ordered_json; raise SystemExit(0 if importlib.resources.files('polyspec.ordered_json').joinpath('py.typed').is_file() else 'the wheel lacks the py.typed marker of polyspec.ordered_json')"]
      },
      "lock": { "polyspec-ordered-json": "packages/python/pylock.toml" },
      "polyspec": {}
    }
  },
  "proof": {
    "gitTag": {
      "packages/rust/Cargo.toml": {
        "kind": "rust",
        "name": "polyspec-ordered-json",
        "smoke": ["cargo", "check"]
      }
    }
  }
}
