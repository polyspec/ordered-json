{
  "schema_version": 1,
  "url": "https://github.com/polyspec/ordered-json.git",
  "repositories": {
    "javascript": {
      "path": "js"
    },
    "rust": {
      "path": "rust"
    },
    "go": {
      "path": "go"
    },
    "php": {
      "path": "php"
    },
    "php-extension": {
      "path": "php-extension"
    },
    "python": {
      "path": "python"
    }
  },
  "implementations": {
    "js": {
      "repository": "javascript",
      "command": [
        "node",
        "{javascript}/test/probe.mjs"
      ],
      "tests": {
        "cwd": "{javascript}",
        "command": [
          "node",
          "test/api.mjs"
        ]
      },
      "test_cases": {
        "cwd": "{javascript}",
        "command": [
          "node",
          "test/api.mjs",
          "--cases"
        ],
        "format": "lines"
      },
      "api_symbols": {
        "cwd": "{javascript}",
        "command": [
          "node",
          "test/api_symbols.mjs"
        ]
      },
      "runtime": {
        "node": [
          "node",
          "--version"
        ]
      }
    },
    "rust": {
      "repository": "rust",
      "env": {
        "CARGO_TARGET_DIR": "{cache}/rust-target",
        "RUSTUP_AUTO_INSTALL": "0"
      },
      "prepare": [
        {
          "cwd": "{rust}",
          "command": [
            "{cargo}",
            "fmt",
            "--check"
          ]
        },
        {
          "cwd": "{rust}",
          "command": [
            "{cargo}",
            "build",
            "--locked",
            "--quiet",
            "--example",
            "probe"
          ]
        }
      ],
      "command": [
        "{cache}/rust-target/debug/examples/probe"
      ],
      "tests": {
        "cwd": "{rust}",
        "command": [
          "{cargo}",
          "test",
          "--locked",
          "--",
          "--test-threads=1"
        ]
      },
      "test_cases": {
        "cwd": "{rust}",
        "command": [
          "{cargo}",
          "test",
          "--locked",
          "--quiet",
          "--",
          "--list",
          "--format",
          "terse"
        ],
        "format": "cargo-terse"
      },
      "api_symbols": {
        "cwd": "{rust}",
        "command": [
          "{cargo}",
          "run",
          "--locked",
          "--quiet",
          "--example",
          "api"
        ]
      },
      "runtime": {
        "rustc": [
          "{rustc}",
          "--version"
        ]
      }
    },
    "go": {
      "repository": "go",
      "env": {
        "GOTOOLCHAIN": "local"
      },
      "prepare": [
        {
          "cwd": "{go}",
          "command": [
            "go",
            "build",
            "-o",
            "{cache}/go-probe",
            "./internal/probe"
          ]
        }
      ],
      "command": [
        "{cache}/go-probe"
      ],
      "tests": {
        "cwd": "{go}",
        "command": [
          "go",
          "test",
          "-v",
          "-p",
          "1",
          "./..."
        ]
      },
      "test_cases": {
        "cwd": "{go}",
        "command": [
          "go",
          "test",
          "-list",
          ".*",
          "-json",
          "./..."
        ],
        "format": "go-test-json"
      },
      "api_symbols": {
        "cwd": "{go}",
        "command": [
          "go",
          "run",
          "./internal/apilist",
          "."
        ]
      },
      "runtime": {
        "go": [
          "go",
          "version"
        ]
      }
    },
    "php": {
      "repository": "php",
      "command": [
        "php",
        "-n",
        "{php}/tests/probe.php"
      ],
      "tests": {
        "cwd": "{php}",
        "command": [
          "php",
          "-n",
          "tests/api.php"
        ]
      },
      "test_cases": {
        "cwd": "{php}",
        "command": [
          "php",
          "-n",
          "tests/api.php",
          "--cases"
        ],
        "format": "lines"
      },
      "api_symbols": {
        "cwd": "{php}",
        "command": [
          "php",
          "-n",
          "tests/api_symbols.php"
        ]
      },
      "runtime": {
        "php": [
          "php",
          "-n",
          "-r",
          "echo PHP_VERSION;"
        ]
      }
    },
    "php-extension": {
      "repository": "php-extension",
      "dependencies": [
        "php"
      ],
      "build_in_copy": true,
      "prepare": [
        {
          "cwd": "{php-extension}/src",
          "if_exists": "{php-extension}/src/Makefile",
          "command": [
            "make",
            "distclean"
          ]
        },
        {
          "cwd": "{php-extension}/src",
          "command": [
            "phpize",
            "--clean"
          ]
        },
        {
          "cwd": "{php-extension}/src",
          "command": [
            "phpize"
          ]
        },
        {
          "cwd": "{php-extension}/src",
          "command": [
            "./configure",
            "--enable-ordered-json"
          ]
        },
        {
          "cwd": "{php-extension}/src",
          "command": [
            "make",
            "-j2"
          ]
        }
      ],
      "command": [
        "php",
        "-n",
        "-d",
        "extension={php-extension}/src/modules/ordered_json.so",
        "{php}/tests/probe.php",
        "--native"
      ],
      "tests": {
        "cwd": "{php-extension}",
        "command": [
          "php",
          "-n",
          "-d",
          "extension={php-extension}/src/modules/ordered_json.so",
          "tests/descriptors.php",
          "{php}/src/OrderedJson.php"
        ]
      },
      "test_cases": {
        "cwd": "{php-extension}",
        "command": [
          "php",
          "-n",
          "-d",
          "extension={php-extension}/src/modules/ordered_json.so",
          "tests/descriptors.php",
          "{php}/src/OrderedJson.php",
          "--cases"
        ],
        "format": "lines"
      },
      "api_symbols": {
        "cwd": "{php}",
        "command": [
          "php",
          "-n",
          "-d",
          "extension={php-extension}/src/modules/ordered_json.so",
          "tests/api_symbols.php",
          "--native"
        ]
      },
      "runtime": {
        "php": [
          "php",
          "-n",
          "-r",
          "echo PHP_VERSION;"
        ],
        "extension_version": [
          "php",
          "-n",
          "-d",
          "extension={php-extension}/src/modules/ordered_json.so",
          "-r",
          "$native = phpversion('ordered_json'); if ($native !== ORDERED_JSON_VERSION) { fwrite(STDERR, \"phpversion('ordered_json') \" . var_export($native, true) . \" differs from ORDERED_JSON_VERSION \" . ORDERED_JSON_VERSION . \"\\n\"); exit(1); } echo ORDERED_JSON_VERSION;"
        ]
      },
      "artifacts": [
        "{php-extension}/src/modules/ordered_json.so"
      ]
    },
    "python": {
      "repository": "python",
      "command": [
        "python3",
        "{python}/tests/probe.py"
      ],
      "tests": {
        "cwd": "{python}",
        "command": [
          "python3",
          "tests/api.py"
        ]
      },
      "test_cases": {
        "cwd": "{python}",
        "command": [
          "python3",
          "tests/api.py",
          "--cases"
        ],
        "format": "lines"
      },
      "api_symbols": {
        "cwd": "{python}",
        "command": [
          "python3",
          "tests/api_symbols.py"
        ]
      },
      "runtime": {
        "python": [
          "python3",
          "-c",
          "import platform; print(platform.python_version())"
        ]
      }
    }
  }
}
