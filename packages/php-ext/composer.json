{
  "name": "polyspec/ordered-json-php-ext",
  "version": "0.0.9",
  "description": "Native PHP extension for strict JSON with document-order associative objects",
  "type": "php-ext",
  "license": "MIT",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "13.4.2"
  },
  "autoload-dev": {
    "psr-4": {
      "Polyspec\\OrderedJson\\": "../php/src/",
      "Polyspec\\OrderedJson\\Extension\\Tests\\": "tests/",
      "Polyspec\\OrderedJson\\Tests\\": "../php/tests/"
    },
    "files": [
      "../php/src/OrderedJson.php"
    ]
  },
  "php-ext": {
    "extension-name": "polyspec_ordered_json",
    "build-path": "src"
  },
  "config": {
    "platform": {
      "php": "8.4.1"
    }
  }
}
