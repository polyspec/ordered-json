<?xml version="1.0" encoding="UTF-8"?>
<!-- The PHPUnit configuration of the PHP extension; kit parity runs its tests with it (config/parity.json). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         recordTestRunHistory="false"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true">
    <testsuites>
        <testsuite name="ordered-json-extension">
            <file>tests/ValueClassTest.php</file>
            <file>tests/DescriptorTest.php</file>
            <file>tests/ValueApiTest.php</file>
            <file>tests/OfficialTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
