{
  "name": "polyspec/ordered-json",
  "version": "0.0.9",
  "description": "JSON document order at every depth, with optional native parser",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.5",
    "ext-json": "*",
    "ext-pcre": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "13.4.2"
  },
  "suggest": {
    "ext-ordered_json": "Native backend from the polyspec/ordered-json-extension PIE package"
  },
  "autoload": {
    "psr-4": {
      "Polyspec\\OrderedJson\\": "src/"
    },
    "files": [
      "src/OrderedJson.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Polyspec\\OrderedJson\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.0"
    }
  }
}
