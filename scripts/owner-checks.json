{
  "comment": "The owning checks of every tracked path, read by scripts/owner_check.py: make owner-check runs the owners of the changed paths, never the full run, and the pre-commit hook fails a commit while a tracked path matches no rule. tests are verifier unit test modules of scripts/tests ($module is the matched test file itself), languages are implementations that scripts/verify.py --only builds and checks (* is every one), and checks are docs (scripts/docs_check.py) and benchmark (benchmarks/run.py --check). Globs: * within one path segment, ** across segments, {a,b} either alternative.",
  "owners": [
    {"paths": ["**/*.md", "**/docs/documentation-manifest.json", "docs/*.json", "docs/reports/*.json"], "checks": ["docs"]},
    {"paths": ["docs/features.md", "docs/features.ko.md"], "tests": ["test_docs_check", "test_full_run", "test_push_gate"]},
    {"paths": ["docs/plans/execution-checklist.md", "docs/plans/execution-checklist.ko.md"], "tests": ["test_docs_check", "test_full_run", "test_push_gate"]},
    {"paths": ["scripts/tests/test_*.py"], "tests": ["$module"]},
    {"paths": ["scripts/registry.py"], "tests": ["test_repositories", "test_run_isolation", "test_build_runs", "test_failure_collection", "test_tracked_inputs", "test_case_listings", "test_failure_messages", "test_process_groups", "test_verify_runs"], "languages": ["*"]},
    {"paths": ["scripts/verify.py"], "tests": ["test_verify_runs", "test_failure_collection", "test_case_listings", "test_run_isolation", "test_repositories", "test_process_groups", "test_package_conformance"], "languages": ["*"]},
    {"paths": ["scripts/test.py"], "tests": ["test_unit_runner", "test_failure_collection", "test_toolchains", "test_external_pins", "test_run_isolation", "test_docs_check"]},
    {"paths": ["scripts/verification_record.py"], "tests": ["test_docs_check", "test_tracked_inputs", "test_atomic_publish", "test_external_pins", "test_failure_messages", "test_repositories"], "checks": ["docs"]},
    {"paths": ["scripts/docs_check.py"], "tests": ["test_docs_check", "test_tracked_inputs", "test_failure_messages", "test_full_run", "test_push_gate"], "checks": ["docs"]},
    {"paths": ["scripts/full_run.py"], "tests": ["test_full_run", "test_push_gate"]},
    {"paths": ["scripts/ci_run.py"], "tests": ["test_ci_run"]},
    {"paths": ["scripts/push_gate.py", ".githooks/pre-push"], "tests": ["test_push_gate", "test_full_run", "test_failure_messages"]},
    {"paths": ["scripts/owner_check.py", "scripts/owner-checks.json", ".githooks/pre-commit"], "tests": ["test_owner_check", "test_push_gate"]},
    {"paths": ["scripts/toolchains.py", ".node-version", ".python-version", ".php-version", "rust-toolchain.toml"], "tests": ["test_toolchains"]},
    {"paths": ["scripts/check_pie.py"], "tests": ["test_build_runs", "test_run_isolation", "test_external_pins", "test_failure_messages", "test_toolchains"]},
    {"paths": ["scripts/compare_ojson.py", "scripts/comparison/*"], "tests": ["test_comparison_runs", "test_run_isolation", "test_atomic_publish"]},
    {"paths": ["benchmarks/run.py"], "tests": ["test_benchmark", "test_run_isolation", "test_atomic_publish", "test_failure_messages", "test_toolchains"], "checks": ["benchmark"]},
    {"paths": ["benchmarks/*.{mjs,php,json}", "benchmarks/fixtures/*.json", "rust/examples/benchmark.rs", "go/internal/benchmark/*.go"], "checks": ["benchmark"]},
    {"paths": ["Makefile"], "tests": ["test_full_run", "test_push_gate", "test_toolchains", "test_owner_check", "test_ci_run"]},
    {"paths": [".github/workflows/*.yml"], "tests": ["test_push_gate", "test_toolchains", "test_ci_run"]},
    {"paths": [".gitignore"], "tests": ["test_tracked_inputs", "test_full_run"]},
    {"paths": ["implementations.json"], "tests": ["test_repositories", "test_run_isolation", "test_toolchains", "test_case_listings", "test_failure_messages", "test_package_conformance"], "languages": ["*"]},
    {"paths": ["package-tests.json"], "tests": ["test_package_conformance", "test_case_listings"], "languages": ["*"]},
    {"paths": ["external-inputs.json"], "tests": ["test_external_pins", "test_docs_check"], "checks": ["docs"]},
    {"paths": ["package.json", "composer.json"], "tests": ["test_toolchains", "test_failure_messages"]},
    {"paths": ["examples/official.json", "fixtures/**"], "tests": ["test_verify_runs", "test_docs_check"], "languages": ["*"]},
    {"paths": ["js/**"], "languages": ["js"]},
    {"paths": ["js/package.json", "php/composer.json"], "tests": ["test_failure_messages"]},
    {"paths": ["rust/**"], "languages": ["rust"]},
    {"paths": ["go/**"], "languages": ["go"]},
    {"paths": ["php/**"], "languages": ["php", "php-extension"]},
    {"paths": ["php-extension/**"], "languages": ["php-extension"]}
  ]
}
