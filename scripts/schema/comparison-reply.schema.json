{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One reply line of a probe of scripts/compare-ojson.mts: whether the project accepted the document, its decoded tree, its output and its decode error.",
  "type": "object",
  "required": ["ok"],
  "properties": {
    "ok": { "type": "boolean" },
    "tree": { "$ref": "#/$defs/tree" },
    "output": { "type": "string" },
    "decode_error": { "type": "string" }
  },
  "$defs": {
    "tree": {
      "description": "The tree of scripts/reference.mts: ['object', [[name, tree]...]], ['array', [tree...]], ['string', s], ['number', token], ['boolean', b] or ['null'].",
      "oneOf": [
        { "type": "array", "prefixItems": [{ "const": "object" }, { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "$ref": "#/$defs/tree" }], "items": false, "minItems": 2 } }], "items": false, "minItems": 2 },
        { "type": "array", "prefixItems": [{ "const": "array" }, { "type": "array", "items": { "$ref": "#/$defs/tree" } }], "items": false, "minItems": 2 },
        { "type": "array", "prefixItems": [{ "const": "string" }, { "type": "string" }], "items": false, "minItems": 2 },
        { "type": "array", "prefixItems": [{ "const": "number" }, { "type": "string" }], "items": false, "minItems": 2 },
        { "type": "array", "prefixItems": [{ "const": "boolean" }, { "type": "boolean" }], "items": false, "minItems": 2 },
        { "type": "array", "prefixItems": [{ "const": "null" }], "items": false, "minItems": 1 }
      ]
    }
  }
}
