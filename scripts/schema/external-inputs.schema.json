{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "external-inputs.json: the facts of the archive of the supplementary suite that a verification record may name, its case count and the digest of its inputs; the PIE release and the revision of the suite are those of mise.toml.",
  "type": "object",
  "required": [
    "schema_version",
    "supplementary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "supplementary": {
      "type": "object",
      "required": [
        "cases",
        "inputs_sha256"
      ],
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 1
        },
        "inputs_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
