{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "external-inputs.json: the identity of every external input that a verification record may name, the PIE release with the sha256 of its PHAR and the supplementary suite with its revision, case count and the digest of its inputs.",
  "type": "object",
  "required": ["schema_version", "pie", "supplementary"],
  "properties": {
    "schema_version": { "const": 1 },
    "description": { "type": "string" },
    "pie": {
      "type": "object",
      "required": ["release", "url", "phar_sha256"],
      "properties": {
        "release": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "phar_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "supplementary": {
      "type": "object",
      "required": ["project", "url", "revision", "cases", "inputs_sha256"],
      "properties": {
        "project": { "type": "string" },
        "url": { "type": "string" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "cases": { "type": "integer", "minimum": 1 },
        "inputs_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
