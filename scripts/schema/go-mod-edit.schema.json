{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The output of go mod edit -json (https://go.dev/ref/mod#go-mod-edit): the module path, the go version and the toolchain line.",
  "type": "object",
  "required": [
    "Module",
    "Go"
  ],
  "properties": {
    "Module": {
      "type": "object",
      "required": [
        "Path"
      ],
      "properties": {
        "Path": {
          "type": "string"
        }
      }
    },
    "Go": {
      "type": "string"
    },
    "Toolchain": {}
  }
}
