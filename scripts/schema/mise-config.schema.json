{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The parsed mise.toml: its tools, each a version or a table of options (the http tools hold their version and sha256 checksum), which scripts/records.mts and tests/scripts/environment.test.mts read.",
  "type": "object",
  "required": [
    "tools"
  ],
  "properties": {
    "tools": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              },
              "checksum": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
