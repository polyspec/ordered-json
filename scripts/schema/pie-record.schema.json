{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The PIE record of make pie-check (var/records): the fields that scripts/check-evidence.mts checks against the current sources and the pins.",
  "type": "object",
  "required": [
    "pie",
    "commands",
    "cases",
    "implementations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "status": {
      "type": "string"
    },
    "checked_at": {
      "type": "string"
    },
    "sources": {
      "$ref": "#/$defs/manifest"
    },
    "packages": {},
    "supplementary": {},
    "cases": {
      "$ref": "#/$defs/counts"
    },
    "implementations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/implementation"
      }
    },
    "scope": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "pie": {
      "type": "object",
      "properties": {
        "phar_sha256": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "arguments",
          "exit_code"
        ],
        "properties": {
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": "integer"
          }
        }
      }
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "required": [
        "sha256",
        "files"
      ],
      "properties": {
        "sha256": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "official",
        "fixtures",
        "supplementary",
        "total"
      ],
      "properties": {
        "official": {
          "type": "integer",
          "minimum": 0
        },
        "fixtures": {
          "type": "integer",
          "minimum": 0
        },
        "supplementary": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "cases": {
          "type": "number"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
