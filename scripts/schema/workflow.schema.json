{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A parsed workflow of .github/workflows (https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax), the fields that tests/scripts/workflow-rules.test.mts reads.",
  "type": "object",
  "required": [
    "jobs"
  ],
  "properties": {
    "on": {
      "type": "object",
      "properties": {
        "push": {
          "type": "object",
          "properties": {
            "branches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "runs-on": {
            "type": "string"
          },
          "if": {
            "type": "string"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "strategy": {
            "type": "object",
            "properties": {
              "fail-fast": {
                "type": "boolean"
              }
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "uses": {
                  "type": "string"
                },
                "run": {
                  "type": "string"
                },
                "if": {
                  "type": "string"
                },
                "with": {
                  "type": "object"
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "concurrency": {},
    "permissions": {}
  }
}
